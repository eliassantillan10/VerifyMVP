POSTGRES_DB=verifymvp
POSTGRES_USER=verifymvp
POSTGRES_PASSWORD=verifymvp

DATABASE_URL=postgresql://verifymvp:verifymvp@localhost:5432/verifymvp
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=

# Required for Case Breaker grading when grading is enabled. LM Studio runs on
# the Docker host; Compose reaches it through host.docker.internal.
CASE_BREAKER_COACH_ENABLED=false
CASE_BREAKER_GRADING_ENABLED=false
LM_STUDIO_BASE_URL=http://host.docker.internal:1234
LM_STUDIO_API_TOKEN=
LM_STUDIO_MODEL=qwen/qwen3-4b-2507
LM_STUDIO_GRADING_MODEL=qwen/qwen3-4b-2507
LM_STUDIO_TIMEOUT_SECONDS=20
LM_STUDIO_GRADING_TIMEOUT_SECONDS=90
CASE_BREAKER_COACH_MAX_INPUT_CHARS=2000
CASE_BREAKER_COACH_MAX_OUTPUT_TOKENS=500
CASE_BREAKER_GRADING_MAX_INPUT_CHARS=2000
CASE_BREAKER_GRADING_MAX_OUTPUT_TOKENS=200
